{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Windows x64 (vcpkg manifest)",
      "description": "Visual Studio generator, dependencies from vcpkg.json linked statically (dynamic CRT, like OBS). Requires the VCPKG_ROOT environment variable and the libobs SDK (tools/obs-sdk.ps1).",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "default", "configuration": "Release" },
    { "name": "debug",   "configurePreset": "default", "configuration": "Debug" }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "displayName": "Configure and build (Release)",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "release" }
      ]
    }
  ]
}
